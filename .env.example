# ============================================================================
# متغيرات البيئة الخاصة بمشروع مطعم العمدة (Supabase)
# ============================================================================
# انسخ هذا الملف باسم .env في نفس المجلد الرئيسي للمشروع، ثم املأ القيم
# من: Supabase Dashboard → Project Settings → API
#
# لازم تبدأ الأسماء بـ VITE_ عشان Vite يسمح للواجهة الأمامية بقراءتها.
# ============================================================================

# Project URL — من Settings → API → Project URL
VITE_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Anon / Public Key — من Settings → API → Project API keys → anon public
# (هذا المفتاح آمن الظهور في كود الواجهة الأمامية، الحماية الحقيقية في RLS)
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJI......(مفتاح anon الكامل هنا)"

# لا تضع أبداً service_role key هنا أو في أي مكان بالواجهة الأمامية.
